# PitchTrainer Environment Configuration
# Copy this file to .env (local dev) or .env.production (Docker on server).
# Both are gitignored. The Docker stack reads .env.production via env_file.

# Mistral AI API Configuration
MISTRAL_API_KEY=your_mistral_api_key_here

# Application Configuration
NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/pitrain.db

# Security Configuration
# Production: https://pitrain.waffelwurst.de
# Local dev:  http://localhost:3000
ALLOWED_ORIGINS=https://pitrain.waffelwurst.de

# Model Configuration
MISTRAL_TRANSCRIPTION_MODEL=voxtral-mini-latest
MISTRAL_EVALUATION_MODEL=mistral-small-latest

# API Endpoints
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# Performance Settings
MAX_AUDIO_DURATION=900
MAX_FILE_SIZE=10485760
REQUEST_TIMEOUT=30000

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
